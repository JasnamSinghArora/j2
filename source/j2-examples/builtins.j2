# Built-in functions covered.

print(abs(-5))
print(ceil(3.1))
print(floor(3.9))
print(round(3.5))
print(pow(2, 10))
print(sqrt(16))
print(contains([1,2,3], 2))
print(contains("hello", "ell"))
print(count([1,2,3,4,5]))
print(len("hello"))
print(lower("HELLO"))
print(upper("hello"))
print(reverse([1,2,3]))
print(sort([3,1,4,1,5]))
print(slice([1,2,3,4,5], 1, 3))
print(split("a,b,c", ","))
print(join(["a","b","c"], ","))
print(trim("  hi  "))
print(num("42"))
print(str(42))
print(fmt("x = {}, y = {}", 3, 7))
print(sum([3, 1, 4, 1, 5]))
print(max([3, 1, 4, 1, 5]))
print(min([3, 1, 4, 1, 5]))
