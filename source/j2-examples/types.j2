# Built-in types: val, seq, flow, pair, map.

x = 5
y = 3.14
z = "hello"
flag = true
print(x)
print(y)
print(z)
print(flag)
print(null)

# seq
s = [1, 2, 3, 4, 5]
print(s)
print(s[0])
print(s[2])

# ranges (flows)
r = collect(1..5)
print(r)

# pair
p = (3, 7)
print(p)

# map
m = {name: "Jay", age: 20}
print(m.name)
print(m.age)

# Mutable bindings.
xx := 5
xx = 10
print(xx)
