+    pub(crate) fn parse_parallelize(slot: &mut ParallelizeMode, v: Option<&str>) -> bool {
+        *slot = match v {
+            // bare flag and on/yes/y/true force on
+            Some("on" | "" | "yes" | "y" | "true") | None => ParallelizeMode::On,
+            // `-C parallelize=off/no/n/false` means "force off".
+            Some("off" | "no" | "n" | "false") => ParallelizeMode::Off,
+            // `-C parallelize=auto` falls through to env-var gating.
+            Some("auto") => ParallelizeMode::Auto,
+            _ => return false,
+        };
+        true
+    }
