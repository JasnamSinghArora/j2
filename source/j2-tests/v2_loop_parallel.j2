# Independent indexed writes use workers above the dispatch threshold.
func score(x: int, bias: int) -> int = x * x + bias
func update(dst: seq<int>, src: seq<int>, bias: int) -> int = {
    for i in 0..len(dst)-1 {
        value = src[i] + 2
        dst[i] = score(value, bias) + dst[i]
    }
    0
}
src = collect(1..40000)
dst := make_seq(40000, 1)
update(dst, src, 3)
assert_eq(dst[0], 13)
assert_eq(dst[1], 20)
assert_eq(dst[39999], 1600160008)

# Filters, branches, and captured scalars remain per-element operations.
divisor = 3
for i in 0..len(dst)-1 if i % divisor == 0 {
    if src[i] % 2 == 0 { dst[i] = dst[i] + 10 }
    else { dst[i] = dst[i] - 2 }
}
assert_eq(dst[0], 11)
assert_eq(dst[1], 20)
assert_eq(dst[39999], 1600160018)

# Read-only gather indices need not match the destination index.
lookup = [7, 11, 13]
gathered := make_seq(40000, 0)
for i in 0..len(gathered)-1 { gathered[i] = lookup[i % 3] + i }
assert_eq(gathered[0], 7)
assert_eq(gathered[1], 12)
assert_eq(gathered[39999], 40006)

# Heterogeneous float-inferred inputs keep the original integer precision.
mixed = [9007199254740993, 0.5]
copied := [0.0, 0.0]
for i in 0..1 if true { copied[i] = mixed[i] }
assert_eq(str(copied[0]), "9007199254740993")
assert_eq(copied[1], 0.5)
changed := [1, 2, 3]
changed[1] = 2.5
changed_copy := [0, 0, 0]
for i in 0..2 if true { changed_copy[i] = changed[i] + 1 }
assert_eq(changed_copy, [2, 3.5, 4])
changed_map = map(changed, _ + 1)
assert_eq(changed_map, [2, 3.5, 4])

# Runtime bounds outside the worker-safe interval retain source semantics.
func bounded(dst: seq<int>, start: int, end: int) -> int = {
    size = len(dst)
    for i in start..end if i >= 0 and i < size { dst[i] = i + 20 }
    0
}
small := [0, 0, 0]
bounded(small, 4, -2)
assert_eq(small, [20, 21, 22])

# Dependencies and aliased sources must retain sequential evaluation.
dependent := [1, 0, 0, 0]
for i in 1..3 { dependent[i] = dependent[i - 1] + 1 }
assert_eq(dependent, [1, 2, 3, 4])
aliased := [1, 0, 0, 0]
alias = aliased
for i in 1..3 { aliased[i] = alias[i - 1] + 1 }
assert_eq(aliased, [1, 2, 3, 4])
func alias_update(dst: seq<int>, src: seq<int>) -> int = {
    for i in 1..3 { dst[i] = src[i - 1] + 1 }
    0
}
function_alias := [1, 0, 0, 0]
alias_update(function_alias, function_alias)
assert_eq(function_alias, [1, 2, 3, 4])
func inferred_alias_update(dst, src) = {
    for i in 1..3 { dst[i] = src[i - 1] + 1 }
    0
}
inferred_alias := [1, 0, 0, 0]
inferred_alias_update(inferred_alias, inferred_alias)
assert_eq(inferred_alias, [1, 2, 3, 4])

# Annotation-compatible numeric inputs retain their actual element values.
func preserve_float_input(xs: seq<int>) -> seq<int> = map(xs, _ + 1)
actual_floats = [2.0, 100000000000000000000.0]
preserved_floats = preserve_float_input(actual_floats)
assert_eq(preserved_floats[0], 3.0)
assert_eq(preserved_floats[1], 100000000000000000000.0)
func preserve_int_input(xs: seq<float>, ids: seq<int>) -> seq<float> = map(ids, func(i) = xs[i])
preserved_ints = preserve_int_input([9007199254740993, 0.5], [0, 1])
assert_eq(str(preserved_ints[0]), "9007199254740993")

# A worker error commits exactly the successful source prefix.
func checked_update(dst: seq<int>, divisors: seq<int>) -> int = {
    for i in 0..len(dst)-1 { dst[i] = 100 % divisors[i] + i }
    0
}
partial := make_seq(40000, -9)
divisors := make_seq(40000, 1)
divisors[17000] = 0
try {
    checked_update(partial, divisors)
    assert false, "worker failure was lost"
} else ZeroDivisionError { print("caught ordered loop failure") }
assert_eq(partial[0], 0)
assert_eq(partial[16999], 16999)
assert_eq(partial[17000], -9)
assert_eq(partial[39999], -9)

# Invalid target bounds must not preempt an earlier RHS error.
func rhs_first(dst: seq<int>) -> int = {
    for i in 0..0 { dst[i] = 1 % 0 }
    0
}
empty := make_seq(0, 0)
try {
    rhs_first(empty)
    assert false, "RHS failure was lost"
} else ZeroDivisionError { print("caught RHS before target bounds") }
print("v2 loop parallel: ok")
