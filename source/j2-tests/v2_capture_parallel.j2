# Gather maps share read-only captures and preserve all input/result storage.
values = collect(1..40000)
indices = collect(0..39999)
func gather_blocks(xs: seq<int>, ids: seq<int>) -> seq<int> = {
    n = len(xs)
    first = map(ids, func(i) = {
        value = xs[i]
        extra := i
        extra += 1
        if value % 2 == 0 { give value * 2 + extra }
        value + n
    })
    map(ids, func(i) = first[i] + xs[i])
}
gathered = gather_blocks(values, indices)
assert_eq(len(gathered), 40000)
assert_eq(gathered[0], 40002)
assert_eq(gathered[1], 8)
assert_eq(gathered[39999], 160000)
assert_eq(values[39999], 40000)

# Captures created inside a native function remain usable after each map.
func reuse_local(xs: seq<int>, ids: seq<int>) -> seq<int> = {
    doubled = map(xs, _ * 2)
    first = map(ids, func(i) = doubled[i])
    map(ids, func(i) = first[i] + doubled[i])
}
reused = reuse_local(values, indices)
assert_eq(reused[0], 4)
assert_eq(reused[39999], 160000)

# A captured usize length and a parameter shadowing that name stay signed ints.
func length_capture(xs: seq<int>, ids: seq<int>) -> seq<int> = {
    n = len(xs)
    first = map(ids, func(i) = xs[i] + n)
    map(first, func(n) = n - 1)
}
lengths = length_capture(values, indices)
assert_eq(lengths[0], 40000)
assert_eq(lengths[39999], 79999)
func local_length(xs: seq<int>, ids: seq<int>) -> seq<int> = map(ids, func(i) = {
    n = len(xs)
    xs[n - i - 1]
})
reversed = local_length(values, indices)
assert_eq(reversed[0], 40000)
assert_eq(reversed[39999], 1)

# Block predicates can return early and use a different local on each branch.
func keep_thirds(xs: seq<int>) -> seq<int> = filter(xs, func(x) = {
    shifted = x + 1
    if shifted % 3 == 0 {
        accepted = true
        give accepted
    }
    rejected = false
    rejected
})
thirds = keep_thirds(values)
assert_eq(len(thirds), 13333)
assert_eq(thirds[0], 2)
assert_eq(thirds[13332], 39998)

# A sequence may be both the callback input and a read-only captured lookup.
func same_storage(xs: seq<int>) -> seq<int> = map(xs, func(i) = xs[i])
identity = same_storage(indices)
assert_eq(identity[0], 0)
assert_eq(identity[39999], 39999)

# Typed failures must retain their J2 kind in both serial and worker paths.
func lookup(xs: seq<int>, ids: seq<int>) -> seq<int> = map(ids, func(i) = xs[i])
bad_negative = make_seq(33000, -1)
try {
    lookup(values, bad_negative)
    assert false, "negative captured index was accepted"
} else IndexError { assert true }
bad_large = make_seq(33000, 40000)
try {
    lookup(values, bad_large)
    assert false, "out-of-range captured index was accepted"
} else IndexError { assert true }
func guarded_lookup(xs: seq<int>, ids: seq<int>) -> seq<int> = map(ids, func(i) = {
    if i < 0 { give 0 }
    if i >= len(xs) { give 1 }
    xs[i]
})
assert_eq(sum(guarded_lookup(values, bad_negative)), 0)
assert_eq(sum(guarded_lookup(values, bad_large)), 33000)
func safe_filter(xs: seq<int>, ids: seq<int>) -> seq<int> = filter(ids, func(i) = i >= 0 and xs[i] > 0)
assert_eq(safe_filter(values, bad_negative), [])
func overflow_local(xs: seq<int>) -> seq<int> = map(xs, func(x) = {
    result := x
    result += 1
    result
})
maximums = make_seq(33000, 9223372036854775807)
try {
    overflow_local(maximums)
    assert false, "compound-assignment overflow was lost"
} else OverflowError { assert true }
func overflow_index(xs: seq<int>, ids: seq<int>) -> seq<int> = map(ids, func(i) = xs[i + 1])
try {
    overflow_index(values, maximums)
    assert false, "index arithmetic overflow was lost"
} else OverflowError { assert true }

# These callbacks have shared writes or dynamic binding semantics and must
# keep their sequential behavior instead of being accepted as pure callbacks.
state := [0]
recorded = map(values, func(x) = {
    state[0] = state[0] + 1
    state[0]
})
assert_eq(state[0], 40000)
assert_eq(recorded[0], 1)
assert_eq(recorded[39999], 40000)
offset = 100
shadowed = map([1, 2], func(x) = {
    offset = offset + 1
    x + offset
})
assert_eq(shadowed, [102, 103])
assert_eq(offset, 100)
# A discarded native-eligible map must not change an input returned by alias.
func return_input(xs: seq<int>) -> seq<int> = {
    discarded = map(xs, func(x) = {
        doubled = x * 2
        doubled
    })
    xs
}
original := [1, 2]
returned := return_input(original)
original[0] = 9
assert_eq(returned[0], 9)
returned[1] = 7
assert_eq(original[1], 7)
try {
    map([1], func(x) = {
        frozen = x
        frozen += 1
        frozen
    })
    assert false, "callback constant became mutable"
} else MutabilityError { assert true }
func generated_name(xs: seq<int>) -> seq<int> = map(xs, func(_) = {
    __j2_item_0 = 100
    _ + __j2_item_0
})
assert_eq(generated_name([1, 2]), [101, 102])
print("v2 captured parallel: ok")
