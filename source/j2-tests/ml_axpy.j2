# AXPY; push() for O(N) seq construction

N = 200000
alpha = 0.5

x := make_seq(N, 0.0)
y := make_seq(N, 0.0)
for i in 0..(N - 1) {
    x[i] = i * 1.0
    y[i] = i * 2.0
}

t = time.now()
result := make_seq(N, 0.0)
for i in 0..(N - 1) {
    result[i] = y[i] + alpha * x[i]
}
ms = time.elapsed_ms(t)

# Sample last element
expected = (N - 1) * 2.0 + alpha * (N - 1) * 1.0
got = result[N - 1]
print(fmt("ML_AXPY N={} ms={} last={} expected={}", N, ms, got, expected))
