# OOP smoke test, full class system

Point = class {
    x = 0.0
    y = 0.0
    dist() = sqrt(x * x + y * y)
    move(dx, dy) := {
        x = x + dx
        y = y + dy
    }
    ::origin() = Point(x: 0, y: 0)
}

p = Point(x: 3, y: 4)
assert p.dist() == 5, "Point(3,4).dist() should be 5"
p.move(1, 1)
# Now x=4, y=5, dist=sqrt(16+25)=sqrt(41)
expected_dist = sqrt(41.0)
assert p.x == 4, "after move x should be 4"
assert p.y == 5, "after move y should be 5"

o = Point::origin()
assert o.x == 0, "origin.x should be 0"
assert o.y == 0, "origin.y should be 0"

print("OOP_SMOKE PASS")
