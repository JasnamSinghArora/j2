# abs, sqrt on exact values
print(fmt("abs {} {} {}", abs(0 - 5), abs(5), abs(0)))
print(fmt("abs float {} {}", abs(0.0 - 2.5), abs(2.5)))
print(fmt("sqrt {} {} {}", sqrt(0.0), sqrt(4.0), sqrt(9.0)))
print(fmt("sqrt16 {}", sqrt(16.0)))
print(fmt("floor {} {} {}", floor(3.7), floor(0.0 - 3.7), floor(3.0)))
print(fmt("ceil {} {} {}", ceil(3.2), ceil(0.0 - 3.2), ceil(3.0)))
print(fmt("round {} {} {}", round(2.4), round(2.6), round(0.0 - 2.6)))
