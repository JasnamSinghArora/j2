# error-agreement test; prefix-sum table, then constant reassignment
prefix := [0, 0, 0, 0, 0]
running := 0
for i in 0..4 {
    running += (i + 1)
    prefix[i] = running
}
# prefix = [1, 3, 6, 10, 15]
assert prefix[0] == 1, "prefix 0"
assert prefix[4] == 15, "prefix 4"
print(fmt("prefix={}", prefix))

# Indexed read-modify-write with skip
acc := [0, 0]
for k in 1..6 {
    skip if k % 2 == 0
    acc[0] = acc[0] + k
}
# odd 1+3+5 = 9
assert acc[0] == 9, "indexed accumulate odds"
print(fmt("acc={}", acc))

# reassigning constant LIMIT must raise MutabilityError
LIMIT = 10
print(fmt("LIMIT before={}", LIMIT))
LIMIT = 20
print("control08 UNREACHABLE")
