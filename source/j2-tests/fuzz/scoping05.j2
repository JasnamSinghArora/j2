# accumulators declared outside loop persist across iterations
base = 2
acc := 0
prod := 1
cnt := 0
for i in 1..6 {
    acc += i          # 1+2+3+4+5+6 = 21
    prod *= base      # 2^6 = 64
    cnt++
}
print(fmt("acc={} prod={} cnt={}", acc, prod, cnt))

# Nested accumulation over an inclusive range.
grid := 0
for r in 1..3 {
    for col in 1..3 {
        grid += r * col
    }
}
print(fmt("grid={}", grid))
