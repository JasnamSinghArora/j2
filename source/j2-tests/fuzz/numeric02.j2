# Remainder with negative operands
i1 = 7 % 3         # 1
i2 = (-7) % 3      # rem_euclid -> 2
i3 = 7 % (-3)      # rem_euclid -> 1
i4 = (-7) % (-3)   # rem_euclid -> 2
i5 = 9 % 3         # 0
print(fmt("i1={} i2={} i3={} i4={} i5={}", i1, i2, i3, i4, i5))
f1 = 7.5 % 2.0     # 1.5
f2 = (-7.5) % 2.0  # -1.5
print(fmt("f1={} f2={}", f1, f2))
print(i2 == 2)
print(i3 == 1)
print(i4 == 2)
