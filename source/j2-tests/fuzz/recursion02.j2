# mutual recursion is_even/is_odd, plus recursive digit-sum

func is_even(n) = {
    if n == 0 { give true }
    give is_odd(n - 1)
}

func is_odd(n) = {
    if n == 0 { give false }
    give is_even(n - 1)
}

func digit_sum(n) = {
    if n < 10 { give n }
    give (n % 10) + digit_sum(n / 10)
}

print(fmt("even0={} even7={} even10={}", is_even(0), is_even(7), is_even(10)))
print(fmt("odd0={} odd7={} odd10={}", is_odd(0), is_odd(7), is_odd(10)))
print(fmt("ds5={} ds12345={} ds9999={}", digit_sum(5), digit_sum(12345), digit_sum(9999)))
