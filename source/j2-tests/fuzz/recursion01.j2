# fibonacci, factorial, gcd; give in every body

func fib(n) = {
    if n < 2 { give n }
    give fib(n - 1) + fib(n - 2)
}

func fact(n) = {
    if n <= 1 { give 1 }
    give n * fact(n - 1)
}

func gcd(a, b) = {
    if b == 0 { give a }
    give gcd(b, a % b)
}

print(fmt("fib0={} fib1={} fib10={} fib15={}", fib(0), fib(1), fib(10), fib(15)))
print(fmt("fact0={} fact1={} fact5={} fact10={}", fact(0), fact(1), fact(5), fact(10)))
print(fmt("gcd48,36={} gcd17,5={} gcd100,0={} gcd0,7={}", gcd(48, 36), gcd(17, 5), gcd(100, 0), gcd(0, 7)))
