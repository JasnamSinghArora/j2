# repeat loops, countdown plus nested triangular sum
total := 0
i := 5
repeat i > 0 {
    total += i
    i--
}
# 5+4+3+2+1 = 15
assert total == 15, "repeat countdown sum"
assert i == 0, "loop var drained to 0"

# nested repeat, sum row x column products
acc := 0
r := 1
repeat r <= 3 {
    c := 1
    repeat c <= 3 {
        acc += r * c
        c++
    }
    r++
}
# (1+2+3) * (1+2+3) = 36
assert acc == 36, "nested repeat product sum"

# false guard never runs the body
never := 0
repeat false {
    never++
}
assert never == 0, "false-guard repeat skips body"

print(fmt("control03 total={} acc={} never={}", total, acc, never))
print("control03 PASS")
