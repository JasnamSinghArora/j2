# single `native {}` block demo; prefer sys.cpu_count()

n_cores = native {
    let n = std::thread::available_parallelism()
        .map(|n| n.get() as i64)
        .unwrap_or(1);
    J2Value::Int(n)
}
print(fmt("escape-hatch cores={}", n_cores))
print(fmt("sys.cpu_count()  ={}", sys.cpu_count()))
